{
  "name": "the-club",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --host 127.0.0.1",
    "dev:reset": "THE_CLUB_ENABLE_DEV_RESET=true VITE_THE_CLUB_ENABLE_DEV_RESET=true vite dev --port 3000 --host 127.0.0.1",
    "dev:lan": "vite dev --port 3000 --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:tauri": "vite build --mode tauri && node scripts/fix-tauri-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:seed": "jiti prisma/seed.ts",
    "db:reset-admin": "jiti prisma/reset-admin-password.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.57",
    "@tanstack/router-plugin": "1.168.40",
    "@tauri-apps/api": "^2.11.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "4.2.1",
    "lucide-react": "1.38.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router-devtools": "1.167.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "vite": "^8.1.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "dompurify": "3.4.13",
    "js-yaml": "4.3.2",
    "mysql2": "3.24.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "shell-quote": "1.10.0",
    "undici": "7.29.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
